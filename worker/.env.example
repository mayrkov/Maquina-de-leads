# Worker de mídia e IA. Copie para worker/.env e preencha. Nunca commite o .env.

# Fila e mídia (arquitetura D3 e D4). DATABASE_URL usa o usuário de banco do worker, que só tem SELECT e UPDATE em
# tarefas_midia. MIDIA_ROOT é a mesma pasta do disco "midia" do Laravel (app/storage/app/midia por padrão).
DATABASE_URL=postgres://maquina_worker:SENHA@127.0.0.1:5432/maquina_de_leads
MIDIA_ROOT=
# Identificador nos logs e na coluna worker_id (vazio = máquina-pid)
WORKER_ID=
# Intervalo do sinal de vida, em segundos (o Laravel devolve a tarefa à fila depois de MIDIA_ABANDONO_SEGUNDOS)
WORKER_HEARTBEAT_SECONDS=30


# Provedor de LLM: antigravity-cli (padrão, custo zero: usa o agy logado no PC). Só para desenvolvimento: com
# médicos pagantes, IA por API com chave e custo por cliente (pendência "Provedor de IA em produção").
# Alternativas pagas: gemini (precisa de GEMINI_API_KEY) | anthropic (precisa de ANTHROPIC_API_KEY)
LLM_PROVIDER=antigravity-cli
# Opcional: só para LLM_PROVIDER=gemini, voice.engine "gemini" ou ANTIGRAVITY_FALLBACK=gemini (API paga)
# GEMINI_API_KEY=
# Modelo usado para roteiro e metadados
GEMINI_MODEL=gemini-3.8-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# claude-code (opcional, nunca é o padrão): Claude Code logado com o plano da pessoa, sem chave de API. Só vale se uma tarefa
# escolher "claude-code" (Configurações > IA por tarefa) ou LLM_PROVIDER=claude-code. A cota é a do plano; confira os termos dele.
# CLAUDE_CLI_PATH=claude
# CLAUDE_CLI_MODEL=sonnet
# CLAUDE_CLI_TIMEOUT_S=240

# antigravity-cli: usa o Antigravity CLI (agy) já logado no PC, sem chave de API (gasta os créditos do plano)
# Binário (nome no PATH ou caminho completo)
ANTIGRAVITY_CLI_PATH=agy
# Modelo (veja `agy models`); vazio = gemini-3.8-flash-medium (thinking escolhe -low/-medium/-high)
ANTIGRAVITY_MODEL=
# Tempo máximo por chamada, em segundos (padrão 240)
ANTIGRAVITY_CLI_TIMEOUT_S=240
# Novas tentativas quando uma chamada estoura o tempo (padrão 2; não gastam as tentativas de cota)
LLM_TIMEOUT_RETRIES=2
# Quantos processos agy ao mesmo tempo
ANTIGRAVITY_CLI_CONCURRENCY=2
# Sessão contínua: quantas perguntas cada processo agy responde antes de ser reiniciado (0 = um processo por chamada)
ANTIGRAVITY_CLI_SESSION_TURNS=0
# Se o agy falhar: none (custo zero) | gemini (usa a API paga com GEMINI_API_KEY)
ANTIGRAVITY_FALLBACK=none

# Busca na web (só para IA sem busca própria): a SUA chave da Tavily. Com SearXNG próprio não precisa de chave.
TAVILY_API_KEY=

# Edição: python do venv com python/requirements-cuts.txt. Vazio = worker/.venv-cuts/.
CUTS_PYTHON=
# Modelo e dispositivo do faster-whisper para transcrever o vídeo bruto (padrão base/cpu; "small" + "cuda" com GPU)
CUTS_WHISPER_MODEL=
CUTS_WHISPER_DEVICE=
# Fonte TTF das legendas (vazio = Impact/Arial Bold no Windows, DejaVu/Liberation Bold no Linux)
CUTS_FONT=
