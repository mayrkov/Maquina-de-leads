{
  "name": "maquina-de-leads-worker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "description": "Worker de mídia e IA da Máquina de Leads: consome tarefas_midia no PostgreSQL (arquitetura D3 e D4).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx src/worker/main.ts",
    "edit": "tsx scripts/edit.ts",
